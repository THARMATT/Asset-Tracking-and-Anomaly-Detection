# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ==========================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# SQLite Database Location (Absolute path or relative to backend folder)
DATABASE_PATH=asset_tracking.db

# AWS IoT Core Configuration
# Your unique AWS IoT Core endpoint (e.g., xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com)
AWS_IOT_ENDPOINT=your-endpoint-ats.iot.us-east-1.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CLIENT_ID=flask_asset_backend_subscriber
AWS_IOT_TOPIC=assets/tracking/events

# Paths to AWS IoT X.509 Certificates (Mutual TLS)
AWS_ROOT_CA_PATH=certificates/AmazonRootCA1.pem
AWS_CERT_PATH=certificates/certificate.pem.crt
AWS_KEY_PATH=certificates/private.pem.key

# MQTT Settings
MQTT_KEEPALIVE=60
MQTT_QOS=1

# System Logic Defaults
MAIN_GATE_ZONE_ID=MAIN_GATE
AUDIT_INACTIVITY_THRESHOLD_SECONDS=3600
